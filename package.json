{
  "name": "dsh-session-ops",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web 会话管理：设置 → 会话管理，一键归档 / 一键还原 / 一键删除。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxl8182/dsh-session-ops.git"
  },
  "homepage": "https://github.com/lxl8182/dsh-session-ops#readme",
  "bugs": {
    "url": "https://github.com/lxl8182/dsh-session-ops/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-web-react"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
